# Database Configuration
POSTGRES_USER=alphasignal
POSTGRES_PASSWORD=alphasignal_dev_password
POSTGRES_DB=alphasignal
DATABASE_URL=postgresql://alphasignal:alphasignal_dev_password@localhost:5432/alphasignal

# Redis Configuration
REDIS_PASSWORD=alphasignal_redis_dev
REDIS_URL=redis://:alphasignal_redis_dev@localhost:6379

# API Configuration
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Web App Configuration
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
VITE_RAZORPAY_KEY_ID=

# Celery Configuration
CELERY_BROKER_URL=redis://:alphasignal_redis_dev@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:alphasignal_redis_dev@localhost:6379/0

# Python Configuration
PYTHONUNBUFFERED=1

# External APIs (Add your keys here)
NSE_API_KEY=
BSE_API_KEY=
YAHOO_FINANCE_API_KEY=

# NLP & AI APIs
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Razorpay Payment Gateway Configuration
# Get your keys from: https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set to 'true' for local testing without real payments
RAZORPAY_MOCK_MODE=true

# Mock Price Simulator (for development)
MOCK_PRICES=true

# Monitoring & Alerting Configuration
# API keys for system monitoring endpoints
METRICS_API_KEY=your-metrics-api-key-change-in-production
ADMIN_API_KEY=your-admin-api-key-change-in-production

# Error Tracking (Sentry)
# Get your DSN from: https://sentry.io/
SENTRY_DSN=

# LLM Cost Tracking
# Daily cost limit in USD for Claude API usage
# Alert will be triggered if this limit is exceeded
LLM_DAILY_COST_LIMIT_USD=100.0
