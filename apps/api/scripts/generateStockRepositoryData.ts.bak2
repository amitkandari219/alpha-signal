        sourceNames: ['PIB India'],
        tags: ['pli-scheme', 'government', 'incentives', 'electronics'],
        confidence: 'HIGH',
      }
    });

    await prisma.stockEvent.create({
      data: {
        companyId: dixon.id,
        eventType: 'PRODUCT_LAUNCH',
        eventDate: daysAgo(210),
