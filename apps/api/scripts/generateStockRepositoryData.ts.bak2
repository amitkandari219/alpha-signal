/**
 * Generate Sample Data for Stock Knowledge Repository
 *
 * Creates for Dixon, Deepak Nitrite, Polycab, Clean Science, Astral:
 * - 100+ events (20-30 per company spanning 2 years)
 * - 15-25 milestones (3-5 per company)
 * - 35 profile sections (7 sections × 5 companies)
 * - 10 timeline summaries (2 per company)
 */

import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

// Helper to generate dates
const daysAgo = (days: number) => {
  const date = new Date();
  date.setDate(date.getDate() - days);
  return date;
};

const monthsAgo = (months: number) => {
  const date = new Date();
  date.setMonth(date.getMonth() - months);
  return date;
};

async function main() {
  console.log('🎯 Generating Stock Knowledge Repository Sample Data...\n');

  // Get the 5 seed companies
  const companies = await prisma.company.findMany({
    where: {
      nseSymbol: {
        in: ['DIXON', 'DEEPAKNTR', 'POLYCAB', 'CLEAN', 'ASTRAL']
      }
    }
  });

  if (companies.length !== 5) {
    console.error('❌ Expected 5 companies, found', companies.length);
    return;
  }

  console.log(`✓ Found ${companies.length} companies\n`);

  // ═══════════════════════════════════════════════════════════════
  // DIXON TECHNOLOGIES - EMS/Electronics
  // ═══════════════════════════════════════════════════════════════
  const dixon = companies.find(c => c.nseSymbol === 'DIXON');
  if (dixon) {
    console.log('📊 Generating data for Dixon Technologies...');

    // Quarterly Results (8 quarters)
    const dixonQuarterlyResults = [
      { q: 1, fy: 2024, revenue: 2100, growth: 32, margin: 4.8, pat: 95, days: 730 },
      { q: 2, fy: 2024, revenue: 2450, growth: 41, margin: 5.1, pat: 115, days: 640 },
      { q: 3, fy: 2024, revenue: 3200, growth: 68, margin: 5.4, pat: 168, days: 550 },
      { q: 4, fy: 2024, revenue: 3500, growth: 55, margin: 5.2, pat: 175, days: 460 },
      { q: 1, fy: 2025, revenue: 3100, growth: 48, margin: 4.9, pat: 140, days: 370 },
      { q: 2, fy: 2025, revenue: 3650, growth: 49, margin: 5.3, pat: 185, days: 280 },
      { q: 3, fy: 2025, revenue: 4200, growth: 31, margin: 5.5, pat: 220, days: 190 },
      { q: 4, fy: 2025, revenue: 4500, growth: 29, margin: 5.4, pat: 235, days: 100 },
    ];

    for (const qr of dixonQuarterlyResults) {
      await prisma.stockEvent.create({
        data: {
          companyId: dixon.id,
          eventType: 'QUARTERLY_RESULT',
          eventDate: daysAgo(qr.days),
          title: `Q${qr.q} FY${qr.fy} Results: Revenue ₹${qr.revenue} Cr (+${qr.growth}% YoY)`,
          summary: `Dixon Technologies reported strong results for Q${qr.q} FY${qr.fy} with revenue of ₹${qr.revenue} Cr, up ${qr.growth}% YoY. Operating margin improved to ${qr.margin}%. PAT stood at ₹${qr.pat} Cr. Mobile manufacturing continues to drive growth with strong order book visibility.`,
          detailedContent: {
            revenue: qr.revenue,
            yoy_growth: qr.growth,
            operating_margin: qr.margin,
            pat: qr.pat,
            eps: (qr.pat / 6.5).toFixed(2),
            highlights: ['Mobile manufacturing robust', 'PLI approvals expected', 'Capacity at 85%+']
          },
          impactAssessment: qr.growth > 40 ? 'VERY_POSITIVE' : qr.growth > 25 ? 'POSITIVE' : 'NEUTRAL',
          impactAreas: ['revenue', 'margins', 'growth'],
          sourceUrls: ['https://www.bseindia.com/'],
          sourceNames: ['BSE India'],
          fiscalYear: qr.fy,
          fiscalQuarter: qr.q,
          tags: ['quarterly-results', 'earnings', 'electronics'],
          confidence: 'HIGH',
        }
      });
    }

    // Other Events
    await prisma.stockEvent.create({
      data: {
        companyId: dixon.id,
        eventType: 'ORDER_WIN',
        eventDate: daysAgo(45),
        title: 'Major Order Win: Samsung Mobile Manufacturing Contract (₹8,000 Cr)',
        summary: 'Dixon secured landmark ₹8,000 Cr contract from Samsung for mobile phone manufacturing over next 3 years. This strengthens position as India\'s largest EMS player and validates manufacturing capabilities. Expected to commence Q2 FY2026.',
        detailedContent: {
          order_value: 8000,
          customer: 'Samsung Electronics',
          duration: '3 years',
          start_date: 'Q2 FY2026',
          product: 'Mobile phones',
          capacity: '10 million units/year'
        },
        impactAssessment: 'VERY_POSITIVE',
        impactAreas: ['revenue', 'growth', 'order-book'],
        sourceUrls: ['https://economictimes.indiatimes.com/'],
        sourceNames: ['Economic Times'],
        tags: ['order-win', 'samsung', 'mobile', 'strategic'],
        confidence: 'HIGH',
