    await prisma.stockEvent.create({
      data: {
        companyId: dixon.id,
        eventType: 'GOVERNMENT_ORDER',
        eventDate: daysAgo(180),
        title: 'PLI Scheme Approval: Received Government Nod for Mobile & IT Hardware PLI',
        summary: 'Dixon received approval under Production Linked Incentive (PLI) scheme for mobile phones and IT hardware. Eligible for ₹200+ Cr incentives over 5 years based on incremental sales. Major boost to margins and competitiveness.',
