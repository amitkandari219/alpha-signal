// ============================================
// MONITORING & ALERTING MODELS
// ============================================

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

model AlertHistory {
  id           String        @id @default(uuid()) @db.Uuid
  severity     AlertSeverity
  alertType    String        @map("alert_type")
  message      String        @db.Text
  metadata     Json?
  acknowledged Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([severity])
  @@index([alertType])
  @@index([acknowledged])
  @@index([createdAt])
  @@map("alert_history")
}

model ErrorLog {
  id         String   @id @default(uuid()) @db.Uuid
  errorType  String   @map("error_type")
  message    String   @db.Text
  stackTrace String?  @map("stack_trace") @db.Text
  requestId  String?  @map("request_id")
  userId     String?  @map("user_id") @db.Uuid
  route      String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([errorType])
  @@index([userId])
  @@index([createdAt])
  @@map("error_log")
}

// ============================================
// WEEKLY REPORTS MODELS
// ============================================

model WeeklyReport {
  id            String     @id @default(uuid()) @db.Uuid
  reportType    ReportType @map("report_type")
  sectorId      String?    @map("sector_id") @db.Uuid
  title         String
  slug          String     @unique
  coverImageUrl String?    @map("cover_image_url")
  summary       String     @db.Text
  fullContent   Json       @map("full_content")
  publishedAt   DateTime?  @map("published_at")
  fiscalWeek    Int        @map("fiscal_week")
  fiscalYear    Int        @map("fiscal_year")
  isPublished   Boolean    @default(false) @map("is_published")
  viewCount     Int        @default(0) @map("view_count")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // Relationships
  sector          Sector?           @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  reportSections  ReportSection[]
  newsletterQueue NewsletterQueue[]

  @@unique([reportType, sectorId, fiscalYear, fiscalWeek])
  @@index([reportType, isPublished, publishedAt])
  @@index([sectorId, isPublished])
  @@index([fiscalYear, fiscalWeek])
  @@index([slug])
  @@map("weekly_reports")
}

model ReportSection {
  id           String      @id @default(uuid()) @db.Uuid
  reportId     String      @map("report_id") @db.Uuid
  sectionOrder Int         @map("section_order")
  sectionTitle String      @map("section_title")
  sectionType  SectionType @map("section_type")
  content      Json
  createdAt    DateTime    @default(now()) @map("created_at")

  // Relationships
  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, sectionOrder])
  @@map("report_sections")
}

model NewsletterSubscriber {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String?             @unique @map("user_id") @db.Uuid
  email             String              @unique
  subscribedSectors Json                @map("subscribed_sectors")
  frequency         NewsletterFrequency @default(WEEKLY)
  isActive          Boolean             @default(true) @map("is_active")
  subscribedAt      DateTime            @default(now()) @map("subscribed_at")
  unsubscribedAt    DateTime?           @map("unsubscribed_at")

  // Relationships
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  newsletterQueue NewsletterQueue[]

  @@index([email])
  @@index([isActive, frequency])
  @@map("newsletter_subscribers")
}

model NewsletterQueue {
  id           String    @id @default(uuid()) @db.Uuid
  reportId     String    @map("report_id") @db.Uuid
  subscriberId String    @map("subscriber_id") @db.Uuid
  scheduledFor DateTime  @map("scheduled_for")
  sentAt       DateTime? @map("sent_at")
  status       String    @default("pending") // pending, sent, failed
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relationships
  report     WeeklyReport         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId, status])
  @@index([reportId])
  @@index([scheduledFor, status])
  @@map("newsletter_queue")
}

// ============================================
// STOCK KNOWLEDGE REPOSITORY MODELS
// ============================================

model StockEvent {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  eventType        EventType         @map("event_type")
  eventDate        DateTime          @map("event_date") @db.Date
  title            String
  summary          String            @db.Text
  detailedContent  Json              @map("detailed_content")
  impactAssessment ImpactAssessment  @map("impact_assessment")
  impactAreas      String[]          @map("impact_areas")
  sourceUrls       String[]          @map("source_urls")
  sourceNames      String[]          @map("source_names")
  aiGenerated      Boolean           @default(true) @map("ai_generated")
  confidence       ConfidenceLevel
  isVerified       Boolean           @default(false) @map("is_verified")
  tags             String[]
  fiscalYear       Int?              @map("fiscal_year")
  fiscalQuarter    Int?              @map("fiscal_quarter")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  // Relationships
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, eventDate])
  @@index([eventType, eventDate])
  @@index([impactAssessment])
  @@index([eventDate])
  @@index([fiscalYear, fiscalQuarter])
  @@index([isVerified])
  @@map("stock_events")
}

model StockMilestone {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  milestoneType MilestoneType @map("milestone_type")
  date         DateTime      @db.Date
  title        String
  description  String        @db.Text
  significance String        @db.Text
  relatedEventIds String[]   @map("related_event_ids") @db.Uuid
  metadata     Json?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relationships
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([milestoneType])
  @@index([date])
  @@map("stock_milestones")
}

model CompanyTimelineSummary {
  id           String              @id @default(uuid()) @db.Uuid
  companyId    String              @map("company_id") @db.Uuid
  periodType   TimelinePeriodType  @map("period_type")
  startDate    DateTime            @map("start_date") @db.Date
  endDate      DateTime            @map("end_date") @db.Date
  keyEvents    Json                @map("key_events")
  majorChanges Json                @map("major_changes")
  narrative    String              @db.Text
  metrics      Json
  generatedAt  DateTime            @default(now()) @map("generated_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  // Relationships
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodType])
  @@index([companyId, periodType])
  @@index([generatedAt])
  @@map("company_timeline_summaries")
}

model CompanyProfile {
  id          String                     @id @default(uuid()) @db.Uuid
  companyId   String                     @map("company_id") @db.Uuid
  sectionType CompanyProfileSectionType  @map("section_type")
  content     Json
  lastUpdated DateTime                   @default(now()) @map("last_updated")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  // Relationships
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, sectionType])
  @@index([companyId, sectionType])
  @@map("company_profiles")
}

// ============================================
// GENERATED REPORTS MODELS
// ============================================

model GeneratedReport {
  id                String                    @id @default(uuid()) @db.Uuid
  symbol            String                    // Stock symbol (e.g., "RELIANCE")
  companyId         String                    @map("company_id") @db.Uuid
  reportType        GeneratedReportType       @default(COMPREHENSIVE) @map("report_type")
  title             String                    // "RELIANCE - Comprehensive Analysis"

  // Report sections (JSON)
  timeline          Json?                     // Company timeline with key events
  businessModel     Json?                     @map("business_model")
  financials        Json?                     // 5-year financial summary
  moat              Json?                     // Competitive advantages
  supplyChain       Json?                     @map("supply_chain")
  catalysts         Json?                     // Growth drivers
  govtImpact        Json?                     @map("govt_impact")
  globalTrade       Json?                     @map("global_trade")
  risks             Json?                     // Risk analysis
  aiSummary         Json?                     @map("ai_summary")

  // Metadata
  metadata          Json?                     // Generation params, model version
  generationMetrics Json?                     @map("generation_metrics")

  // Analytics
  viewCount         Int                       @default(0) @map("view_count")
  downloadCount     Int                       @default(0) @map("download_count")

  // Lifecycle
  status            ReportGenerationStatus    @default(COMPLETED)
  generatedAt       DateTime                  @default(now()) @map("generated_at")
  expiresAt         DateTime?                 @map("expires_at")
  lastAccessedAt    DateTime?                 @map("last_accessed_at")
  archivedAt        DateTime?                 @map("archived_at")

  // Relationships
  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedBy       String?                   @map("generated_by") @db.Uuid
  user              User?                     @relation(fields: [generatedBy], references: [id], onDelete: SetNull)

  reportViews       ReportView[]

  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@unique([companyId, reportType, generatedAt])
  @@index([symbol, status, generatedAt])
  @@index([expiresAt])
  @@index([status, generatedAt])
  @@map("generated_reports")
}

model ReportView {
  id        String           @id @default(uuid()) @db.Uuid
  reportId  String           @map("report_id") @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  ipAddress String?          @map("ip_address")
  userAgent String?          @map("user_agent")
  viewedAt  DateTime         @default(now()) @map("viewed_at")

  report    GeneratedReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reportId, viewedAt])
  @@index([userId, viewedAt])
  @@map("report_views")
}

// ============================================
// DATA VALIDATION & SOURCE TRACKING
// ============================================

model DataSourceLog {
  id         String   @id @default(uuid()) @db.Uuid
  symbol     String   // Stock symbol
  field      String   // Field name (e.g., "netMargin", "revenue")
  value      String   // JSON-stringified value
  source     String   // Source name (NSE_API, BSE_API, database, etc.)
  confidence Float    // Confidence score 0-1
  url        String?  // Link to source if available
  metadata   String?  // Additional metadata (JSON)
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@index([symbol, field])
  @@index([symbol, fetchedAt])
  @@index([fetchedAt])
  @@map("data_source_logs")
}
