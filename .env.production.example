# Alpha Signal - Production Environment Variables
# Copy this file to .env.production and fill in the values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
API_PORT=3000
APP_URL=https://alphasignal.in
FRONTEND_URL=https://alphasignal.in

# JWT Secret (generate with: scripts/generate-secrets.sh)
JWT_SECRET=<generate-64-char-random-string>

# ============================================
# DATABASE
# ============================================
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://alphasignal:<password>@postgres:5432/alphasignal
POSTGRES_PASSWORD=<strong-random-password>

# Connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Celery broker and backend
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============================================
# RAZORPAY (PAYMENTS)
# ============================================
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-secret>
RAZORPAY_WEBHOOK_SECRET=<your-webhook-secret>

# For testing in production (remove after launch)
MOCK_PAYMENTS=false

# ============================================
# CLAUDE API (AI)
# ============================================
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Daily cost limit (USD)
LLM_DAILY_COST_LIMIT_USD=10

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
# API keys for internal metrics (generate with: scripts/generate-secrets.sh)
METRICS_API_KEY=<generate-random-key>
ADMIN_API_KEY=<generate-random-key>

# Sentry (optional - for error tracking)
SENTRY_DSN=

# Log level
LOG_LEVEL=info

# ============================================
# EMAIL (OPTIONAL FOR LAUNCH)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@alphasignal.in

# ============================================
# FEATURE FLAGS
# ============================================
# Use mock prices instead of live data (set to false when live data is ready)
MOCK_PRICES=true

# Enable/disable features
ENABLE_WEBSOCKET=true
ENABLE_CACHE=true
ENABLE_RATE_LIMITING=true

# ============================================
# ANALYTICS (OPTIONAL)
# ============================================
# Google Analytics 4
VITE_GA4_ID=

# Mixpanel
MIXPANEL_TOKEN=

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGIN=https://alphasignal.in
ALLOWED_ORIGINS=https://alphasignal.in,https://www.alphasignal.in

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_FREE_TIER=100
RATE_LIMIT_PRO_TIER=1000
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# SESSION & COOKIES
# ============================================
SESSION_SECRET=<generate-random-key>
COOKIE_DOMAIN=.alphasignal.in
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# ============================================
# BACKUP & MAINTENANCE
# ============================================
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================
# MISC
# ============================================
TZ=Asia/Kolkata
